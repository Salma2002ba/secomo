### Exemple de variables d'environnement pour déployer le backend
#
# DATABASE_URL : URL PostgreSQL au format SQLAlchemy/asyncpg
# Exemple (Render) : postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
#
DATABASE_URL=postgresql+asyncpg://secomo:secomo@localhost:5432/secomo

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# CORS : autoriser ton origin GitHub Pages (sans /SECOMO)
# Exemple : https://<username>.github.io
# Peut aussi être une liste JSON: ["https://...","https://..."]
CORS_ORIGINS=https://localhost:3000

